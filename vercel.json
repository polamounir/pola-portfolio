{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/skills",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/experience",
      "destination": "/about",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
